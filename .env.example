# Discord 개발자 포털(discord.com/developers/applications)에서 발급받은 봇 토큰
DISCORD_TOKEN=

# 서버(길드) ID - 서버 아이콘 우클릭 > ID 복사 (개발자 모드 켜야 보임)
GUILD_ID=

# 역할 ID - 각 역할 우클릭 > ID 복사
ROLE_ID_REBOOT=
ROLE_ID_GROW=      # 그로우-크루
ROLE_ID_MASTER=    # 마스터-크루
ROLE_ID_FREE=      # 무료멤버 - 새로 가입한 멤버에게 자동으로 부여됩니다

# 체크인을 카운트할 채널 이름 (콤마로 구분, # 제외, 정확히 일치해야 함)
TRACK_CHANNEL_NAMES=스크린타임-기록,끄고-인증,자연-인증

# 이미지 첨부 없이 텍스트만으로도 체크인을 인정할 채널 (콤마로 구분)
# 자연-인증 채널의 핀 공지가 "사진이어도 좋고, 한 줄 텍스트여도 좋다"고 안내하므로 기본값에 포함되어 있습니다.
TEXT_OK_CHANNEL_NAMES=자연-인증

# 승급 기준 (누적 횟수)
THRESHOLD_GROW=7
THRESHOLD_MASTER=30

# 결제 링크 (D+30 안내 DM에 삽입)
# ⚠️ 아래는 예시 URL입니다. 실제 결제 페이지 주소로 반드시 교체한 뒤 배포하세요.
# 교체하지 않으면 멤버들이 "(결제 링크 미설정)"이라는 문구를 받게 됩니다.
PAYMENT_LINK=https://example.com/subscribe

# 매일 정기 점검을 도는 시간 (cron, 기본 매일 오전 9시 KST)
DAILY_CRON=0 9 * * *

# 타임존
TIMEZONE=Asia/Seoul

# ─────────────────────────────────────────────────────────
# 아래는 신규 기능 6종 설정입니다. 전부 기본값이 있어서 안 채워도 동작하지만,
# 실제 채널 이름과 다르면 반드시 맞춰 넣어주세요 (# 제외, 정확히 일치해야 함).
# ─────────────────────────────────────────────────────────

# ── 즉시반응 시스템 (#충동-sos) ──
# 충동 채널 이름
SOS_CHANNEL_NAME=충동-sos
# 글이 올라오면 즉시 다는 리액션 이모지
SOS_REACT_EMOJI=🫂
# 몇 명의 헬퍼(그로우/마스터-크루)에게 알림을 보낼지
HELPER_NOTIFY_COUNT=3
# "최근 활동"으로 인정할 기준 - 마지막 체크인이 며칠 이내였는지
HELPER_ACTIVE_WITHIN_DAYS=3
# 같은 헬퍼에게 너무 자주 알림이 가지 않도록 하는 쿨다운 (시간 단위)
HELPER_NOTIFY_COOLDOWN_HOURS=6

# ── 데일리 스트릭 대시보드 ──
# "!기록" 명령어를 인식할 채널 이름
STREAK_CHANNEL_NAME=나의-그래프
# 기록 조회 명령어 문구
STREAK_COMMAND=!기록
# 스트릭이 끊기기 전 저녁에 리마인더를 보내는 시간 (cron, 기본 매일 오후 9시 KST)
STREAK_REMINDER_CRON=0 21 * * *

# ── 승급 알림 & 배지 시스템 ──
# 승급 시 공개 축하 메시지를 남길 채널 이름
ANNOUNCE_CHANNEL_NAME=자유수다
# 멤버가 DM으로 "알림끄기" / "알림켜기"를 보내면 이 공개 알림 수신 여부를 스스로 끄고 켤 수 있습니다.

# ── 멘토 하이라이트 시스템 ──
# 이 이모지로 리액션을 받으면 "도움" 1회로 집계됩니다 (그로우/마스터-크루가 쓴 메시지에 한함)
HELPER_THANKS_EMOJI=🙏
# 주간 도움왕을 발표할 채널 이름
HONOR_CHANNEL_NAME=명예의-전당
# 주간 도움왕을 발표하고 집계를 리셋하는 시간 (cron, 기본 매주 일요일 오후 9시 KST)
WEEKLY_HIGHLIGHT_CRON=0 21 * * 0

# ── 30일 리부트 챌린지 (전자책 구매 D+1 자동 시작 DM 챌린지) ──
# docs/reboot-challenge-plan.md 참고. 전부 기본값이 있어서 안 채워도 동작합니다.
# D+1 자동시작 스캔 + Day7→8 분석 다이제스트를 보내는 시간 (cron, 기본 매일 오전 9시 KST)
REBOOT_MORNING_CRON=0 9 * * *
# 매일 그날의 챌린지 질문을 발송하는 시간 (cron, 기본 매일 오후 8시 KST)
REBOOT_PROMPT_CRON=0 20 * * *
# 그날 답장이 없으면 리마인더를 한 번 더 보내는 시간 (cron, 기본 매일 오후 10시 KST)
REBOOT_REMINDER_CRON=0 22 * * *
# 위기 신호 키워드 감지, SOS 키워드("SOS"라고만 DM) 등은 코드 상단 CRISIS_KEYWORDS_*, 상수로
# 관리합니다 (운영하면서 필요하면 index.js에서 직접 배열만 수정하면 돼요).

# ── 구글시트 실시간 기록 (선택 기능) ──
# 참가자들의 리부트 챌린지 기록(Day0 문장/매일 기록/Day8 공식)을 실시간으로
# 구글시트 한 줄씩 자동으로 쌓아줍니다. 설정 방법은 docs/google-sheets-setup.md 참고.
# 셋 다 안 채우면 이 기능만 조용히 꺼지고, 봇의 다른 기능(구매/워터마크 등)은 그대로 동작해요.
REBOOT_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# 데이터를 쌓을 시트 탭(하단 시트 이름) — 기본값 그대로 써도 됩니다.
REBOOT_SHEET_TAB_NAME=리부트챌린지기록

# ── 매달 30일 챌린지 (금딸챌린지, 30일 리부트 챌린지와 별개) ──
# 전부 기본값이 있어서 하나도 안 채워도 동작합니다 — 아래 등급 역할(RANK_ROLE_ID_1~13)을
# 아직 디스코드에 안 만들었어도 참가/체크인/누적 카운트는 정상 동작하고, 역할 부여만
# 조용히 건너뜁니다. 나중에 디스코드에서 13개 역할을 만들고 여기 ID를 채워 넣으면
# 코드 수정 없이 그 다음 승급부터 바로 적용돼요.
# 참가 명령어 (DM)
MONTHLY_CHALLENGE_COMMAND=!금딸챌린지
# 현황 조회 명령어 (DM)
MONTHLY_CHALLENGE_STATUS_COMMAND=!금딸현황
# 완주로 인정할 누적 성공일수
MONTHLY_CHALLENGE_TARGET_DAYS=30
# 매일 저녁 체크인 질문을 보내는 시간 (cron, 기본 매일 오후 9시 KST)
MONTHLY_CHALLENGE_PROMPT_CRON=0 21 * * *
# 답장이 없으면 리마인더를 한 번 더 보내는 시간 (cron, 기본 매일 오후 10시30분 KST)
MONTHLY_CHALLENGE_REMINDER_CRON=30 22 * * *
# 매달 새 달로 갱신 + 공개 채널 공지를 보내는 시간 (cron, 기본 매달 1일 00:05 KST)
MONTHLY_CHALLENGE_ROLLOVER_CRON=5 0 1 * *
# ── 신규 참가자 모집 DM (선택) ──
# 아직 신청 안 한 멤버에게만, 매달 마지막 주 초입에 먼저 "다음 달 신청하시겠어요?"라고
# DM으로 물어봅니다. 이미 참가 중인 사람은 자동으로 다음 달도 이어지므로 제외돼요.
# "네"류로 답하면 "신청"이라고 보내달라고 한 번 더 안내하고, 실제로 "신청"이 오면
# 기존 !금딸챌린지 참가 로직으로 바로 등록됩니다.
# 발송 시간 (cron, 기본 매달 25일 오후 9시 KST — 어떤 달이든 마지막 주 안에 들어옵니다)
MONTHLY_CHALLENGE_RECRUIT_CRON=0 21 25 * *
# 모집 DM에 대한 답장을 기다리는 시간 (시간 단위, 기본 72시간)
MONTHLY_CHALLENGE_RECRUIT_REPLY_WINDOW_HOURS=72
# ── 인증 채널 (선택) ──
# DM 답장 없이도, 이 채널에 "15일차"처럼 숫자+일차로 시작하는 글(뒤에 하고 싶은
# 말을 자유롭게 붙여도 됨)을 올리면 바로 체크인됩니다. DM 답장(기존 방식)도 그대로
# 병행되니 참가자가 편한 쪽을 쓰면 돼요. 재발/실패 내용은 여기 올리지 말고 DM으로만
# 보고하도록 안내하세요 (공개 노출 방지).
MONTHLY_CHALLENGE_CHECKIN_CHANNEL_NAME=금딸챌린지-인증
# 신청 안 한 사람이 인증 채널에 글 쓰는 걸 막기 위해, 디스코드에서 이 채널의 "메시지
# 보내기" 권한을 이 역할에게만 열어뒀습니다. 참가 신청(!금딸챌린지) 시 봇이 이 역할을
# 자동으로 부여합니다. 비워두면 역할 부여만 조용히 건너뛰고 나머지 기능은 정상 동작해요.
MONTHLY_CHALLENGE_PARTICIPANT_ROLE_ID=
# 서버 소유자 본인 닉네임은 디스코드 정책상 봇이 못 바꿉니다 — 그 외 멤버는 등급이 오를
# 때마다 닉네임 앞에 "[대리]" 같은 태그를 자동으로 붙일지 여부 (기본 꺼짐). 켜기 전에
# 봇에게 "닉네임 관리" 권한을 주고, 봇 역할을 아래 13개 등급 역할보다 위로 올려두세요.
MONTHLY_CHALLENGE_NICKNAME_TAG_ENABLED=false
# 등급 역할 13개 ID (사원→주임→대리→과장→차장→부장→이사→상무→전무→부사장→사장→부회장→회장)
# 기존 ROLE_ID_GROW/ROLE_ID_MASTER와는 완전히 별개의 새 역할입니다 — 헷갈리지 않게
# 디스코드에서 새로 13개 만들어서 순서대로 채워주세요. 비워두면 해당 등급 승급 시
# 역할 부여만 건너뛰고 누적 카운트·공지는 정상 동작합니다.
RANK_ROLE_ID_1=   # 인턴(사원)
RANK_ROLE_ID_2=   # 주임
RANK_ROLE_ID_3=   # 대리
RANK_ROLE_ID_4=   # 과장
RANK_ROLE_ID_5=   # 차장
RANK_ROLE_ID_6=   # 부장
RANK_ROLE_ID_7=   # 이사
RANK_ROLE_ID_8=   # 상무
RANK_ROLE_ID_9=   # 전무
RANK_ROLE_ID_10=  # 부사장
RANK_ROLE_ID_11=  # 사장
RANK_ROLE_ID_12=  # 부회장
RANK_ROLE_ID_13=  # 회장
# 이번 달 완주 시 자동으로 시트에 기록됩니다 (설정 방법은 REBOOT_SHEET_ID 등 위 구글시트
# 섹션과 동일 — 이미 채워져 있으면 별도 설정 없이 그대로 쌓입니다).
MONTHLY_CHALLENGE_SHEET_TAB_NAME=매달챌린지기록
