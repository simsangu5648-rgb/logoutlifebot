# Discord 개발자 포털(discord.com/developers/applications)에서 발급받은 봇 토큰
DISCORD_TOKEN=

# 서버(길드) ID - 서버 아이콘 우클릭 > ID 복사 (개발자 모드 켜야 보임)
GUILD_ID=

# 역할 ID - 각 역할 우클릭 > ID 복사
ROLE_ID_REBOOT=
ROLE_ID_GROW=      # 그로우-크루
ROLE_ID_MASTER=    # 마스터-크루
ROLE_ID_FREE=      # 무료멤버 - 새로 가입한 멤버에게 자동으로 부여됩니다

# 체크인을 카운트할 채널 이름 (콤마로 구분, # 제외, 정확히 일치해야 함)
TRACK_CHANNEL_NAMES=스크린타임-기록,끄고-인증,자연-인증

# 이미지 첨부 없이 텍스트만으로도 체크인을 인정할 채널 (콤마로 구분)
# 자연-인증 채널의 핀 공지가 "사진이어도 좋고, 한 줄 텍스트여도 좋다"고 안내하므로 기본값에 포함되어 있습니다.
TEXT_OK_CHANNEL_NAMES=자연-인증

# 승급 기준 (누적 횟수)
THRESHOLD_GROW=7
THRESHOLD_MASTER=30

# 결제 링크 (D+30 안내 DM에 삽입)
# ⚠️ 아래는 예시 URL입니다. 실제 결제 페이지 주소로 반드시 교체한 뒤 배포하세요.
# 교체하지 않으면 멤버들이 "(결제 링크 미설정)"이라는 문구를 받게 됩니다.
PAYMENT_LINK=https://example.com/subscribe

# 매일 정기 점검을 도는 시간 (cron, 기본 매일 오전 9시 KST)
DAILY_CRON=0 9 * * *

# 타임존
TIMEZONE=Asia/Seoul

# ─────────────────────────────────────────────────────────
# 아래는 신규 기능 6종 설정입니다. 전부 기본값이 있어서 안 채워도 동작하지만,
# 실제 채널 이름과 다르면 반드시 맞춰 넣어주세요 (# 제외, 정확히 일치해야 함).
# ─────────────────────────────────────────────────────────

# ── 즉시반응 시스템 (#충동-sos) ──
# 충동 채널 이름
SOS_CHANNEL_NAME=충동-sos
# 글이 올라오면 즉시 다는 리액션 이모지
SOS_REACT_EMOJI=🫂
# 몇 명의 헬퍼(그로우/마스터-크루)에게 알림을 보낼지
HELPER_NOTIFY_COUNT=3
# "최근 활동"으로 인정할 기준 - 마지막 체크인이 며칠 이내였는지
HELPER_ACTIVE_WITHIN_DAYS=3
# 같은 헬퍼에게 너무 자주 알림이 가지 않도록 하는 쿨다운 (시간 단위)
HELPER_NOTIFY_COOLDOWN_HOURS=6

# ── 데일리 스트릭 대시보드 ──
# "!기록" 명령어를 인식할 채널 이름
STREAK_CHANNEL_NAME=나의-그래프
# 기록 조회 명령어 문구
STREAK_COMMAND=!기록
# 스트릭이 끊기기 전 저녁에 리마인더를 보내는 시간 (cron, 기본 매일 오후 9시 KST)
STREAK_REMINDER_CRON=0 21 * * *

# ── 승급 알림 & 배지 시스템 ──
# 승급 시 공개 축하 메시지를 남길 채널 이름
ANNOUNCE_CHANNEL_NAME=자유수다
# 멤버가 DM으로 "알림끄기" / "알림켜기"를 보내면 이 공개 알림 수신 여부를 스스로 끄고 켤 수 있습니다.

# ── 멘토 하이라이트 시스템 ──
# 이 이모지로 리액션을 받으면 "도움" 1회로 집계됩니다 (그로우/마스터-크루가 쓴 메시지에 한함)
HELPER_THANKS_EMOJI=🙏
# 주간 도움왕을 발표할 채널 이름
HONOR_CHANNEL_NAME=명예의-전당
# 주간 도움왕을 발표하고 집계를 리셋하는 시간 (cron, 기본 매주 일요일 오후 9시 KST)
WEEKLY_HIGHLIGHT_CRON=0 21 * * 0

# ── 30일 리부트 챌린지 (전자책 구매 D+1 자동 시작 DM 챌린지) ──
# docs/reboot-challenge-plan.md 참고. 전부 기본값이 있어서 안 채워도 동작합니다.
# D+1 자동시작 스캔 + Day7→8 분석 다이제스트를 보내는 시간 (cron, 기본 매일 오전 9시 KST)
REBOOT_MORNING_CRON=0 9 * * *
# 매일 그날의 챌린지 질문을 발송하는 시간 (cron, 기본 매일 오후 8시 KST)
REBOOT_PROMPT_CRON=0 20 * * *
# 그날 답장이 없으면 리마인더를 한 번 더 보내는 시간 (cron, 기본 매일 오후 10시 KST)
REBOOT_REMINDER_CRON=0 22 * * *
# 위기 신호 키워드 감지, SOS 키워드("SOS"라고만 DM) 등은 코드 상단 CRISIS_KEYWORDS_*, 상수로
# 관리합니다 (운영하면서 필요하면 index.js에서 직접 배열만 수정하면 돼요).

# ── 구글시트 실시간 기록 (선택 기능) ──
# 참가자들의 리부트 챌린지 기록(Day0 문장/매일 기록/Day8 공식)을 실시간으로
# 구글시트 한 줄씩 자동으로 쌓아줍니다. 설정 방법은 docs/google-sheets-setup.md 참고.
# 셋 다 안 채우면 이 기능만 조용히 꺼지고, 봇의 다른 기능(구매/워터마크 등)은 그대로 동작해요.
REBOOT_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# 데이터를 쌓을 시트 탭(하단 시트 이름) — 기본값 그대로 써도 됩니다.
REBOOT_SHEET_TAB_NAME=리부트챌린지기록
