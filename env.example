# Discord 개발자 포털(discord.com/developers/applications)에서 발급받은 봇 토큰
DISCORD_TOKEN=

# 서버(길드) ID - 서버 아이콘 우클릭 > ID 복사 (개발자 모드 켜야 보임)
GUILD_ID=

# 역할 ID - 각 역할 우클릭 > ID 복사
ROLE_ID_REBOOT=
ROLE_ID_GROW= # 그로우-크루 (전자책 구매 시 자동 승급)
ROLE_ID_MASTER= # 마스터-크루 (그로우-크루가 누적 인증을 더 쌓으면 최종 승급, 아래 THRESHOLD_MASTER 참고)
ROLE_ID_FREE= # 무료멤버 - 새로 가입한 멤버에게 자동으로 부여됩니다 (등급과 무관하게 항상 유지되는 기본 태그)

# 체크인을 카운트할 채널 이름 (콤마로 구분, # 제외, 정확히 일치해야 함)
TRACK_CHANNEL_NAMES=스크린타임-기록,끄고-인증,자연-인증

# 이미지 첨부 없이 텍스트만으로도 체크인을 인정할 채널 (콤마로 구분)
# 자연-인증 채널의 핀 공지가 "사진이어도 좋고, 한 줄 텍스트여도 좋다"고 안내하므로 기본값에 포함되어 있습니다.
TEXT_OK_CHANNEL_NAMES=자연-인증

# 마스터-크루 승급 기준 (누적 횟수). 단, 이미 그로우-크루(전자책 구매 완료)인 사람에게만 적용됩니다.
THRESHOLD_MASTER=30

# 결제 링크 (D+30 안내 DM에 삽입 - 참고용 문구, 실제 자동승급은 아래 PayApp 연동으로 처리됩니다)
PAYMENT_LINK=https://example.com/subscribe

# 매일 정기 점검을 도는 시간 (cron, 기본 매일 오전 9시 KST)
DAILY_CRON=0 9 * * *

# 타임존
TIMEZONE=Asia/Seoul

# ─────────────────────────────────────────────────────────
# 일반멤버(무료) 4단계 등급 시스템
# 전자책을 구매하기 전까지 "일반사람들"은 누적 인증 횟수만으로 이 4단계를 오릅니다.
# 각 단계마다 서버에 배지용 역할을 새로 만들고 ID를 넣어주세요. (안 채우면 그 단계는 조용히 건너뜁니다)
# ─────────────────────────────────────────────────────────
ROLE_ID_FREE_LV1= # 1단계 (기본 라벨: 새싹)
ROLE_ID_FREE_LV2= # 2단계 (기본 라벨: 습관러)
ROLE_ID_FREE_LV3= # 3단계 (기본 라벨: 실천가)
ROLE_ID_FREE_LV4= # 4단계 (기본 라벨: 베테랑)

# 각 단계 승급에 필요한 누적 인증 횟수 (기본값 1 / 7 / 30 / 90)
FREE_LV1_THRESHOLD=1
FREE_LV2_THRESHOLD=7
FREE_LV3_THRESHOLD=30
FREE_LV4_THRESHOLD=90

# 각 단계 이름 (DM/기록 조회에 표시됩니다. 안 채우면 위 기본 라벨 사용)
FREE_LV1_LABEL=새싹
FREE_LV2_LABEL=습관러
FREE_LV3_LABEL=실천가
FREE_LV4_LABEL=베테랑

# ─────────────────────────────────────────────────────────
# 전자책 결제(PayApp) 연동 - 구매 즉시 그로우-크루로 자동 승급됩니다.
# 멤버가 봇에게 DM으로 "구매"라고 보내면 개인화된 결제 링크를 받습니다.
# ─────────────────────────────────────────────────────────
# PayApp 가입 시 만든 아이디 (페이앱 마이페이지 > 내정보에서 확인)
PAYAPP_USERID=
# 페이앱 마이페이지 > 연동관리에서 확인/발급하는 연동 KEY, VALUE
# (결제완료 웹훅이 진짜 페이앱에서 온 게 맞는지 검증하는 용도 - 반드시 채워야 안전합니다)
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# 전자책 상품명 / 가격 (원 단위, 최소 1000원)
EBOOK_NAME=로그아웃라이프 전자책
EBOOK_PRICE=9900
# 결제 완료 시 DM으로 바로 보내드릴 전자책 다운로드 링크 (구글드라이브/드롭박스 공유링크 등)
# 비워두면 "곧 별도로 안내드릴게요"라는 임시 메시지가 대신 나갑니다.
EBOOK_DOWNLOAD_URL=
# Railway에서 발급받은 공개 도메인 (예: https://logoutlifebot-production.up.railway.app)
# Settings > Networking > Generate Domain 으로 만들 수 있습니다. 끝에 슬래시(/)는 붙이지 마세요.
PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────
# 아래는 신규 기능 6종 설정입니다. 전부 기본값이 있어서 안 채워도 동작하지만,
# 실제 채널 이름과 다르면 반드시 맞춰 넣어주세요 (# 제외, 정확히 일치해야 함).
# ─────────────────────────────────────────────────────────

# ── 즉시반응 시스템 (#충동-sos) ──
# 충동 채널 이름
SOS_CHANNEL_NAME=충동-sos
# 글이 올라오면 즉시 다는 리액션 이모지
SOS_REACT_EMOJI=🫂
# 몇 명의 헬퍼(그로우/마스터-크루)에게 알림을 보낼지
HELPER_NOTIFY_COUNT=3
# "최근 활동"으로 인정할 기준 - 마지막 체크인이 며칠 이내였는지
HELPER_ACTIVE_WITHIN_DAYS=3
# 같은 헬퍼에게 너무 자주 알림이 가지 않도록 하는 쿨다운 (시간 단위)
HELPER_NOTIFY_COOLDOWN_HOURS=6
# SOS 직후 "무슨 상황이었는지" DM 질문에 대한 답을 인정할 시간 (분)
TRIGGER_REPLY_WINDOW_MINUTES=30

# ── SOS 온콜 에스컬레이션 (사람이 직접 챙기는 안전망) ──
# 이 두 값을 모두 채우면, SOS가 올라올 때마다 아래 채널에 온콜 역할을 태그해서 알립니다.
# (운영자가 순번을 정해서 그 시간대에 이 역할을 담당자에게 직접 부여/회수하는 방식이에요 - 봇이 당번을 자동으로 정하진 않습니다)
ONCALL_ROLE_ID=
ONCALL_CHANNEL_NAME=

# ── 데일리 스트릭 대시보드 (+ 스트릭 프리즈권) ──
# "!기록" 명령어를 인식할 채널 이름
STREAK_CHANNEL_NAME=나의-그래프
# 기록 조회 명령어 문구
STREAK_COMMAND=!기록
# 스트릭이 끊기기 전 저녁에 리마인더를 보내는 시간 (cron, 기본 매일 오후 9시 KST)
STREAK_REMINDER_CRON=0 21 * * *
# 한 달에 이 횟수만큼은 하루를 걸러도 연속기록이 끊기지 않습니다 (완벽주의로 인한 이탈 방지)
STREAK_FREEZE_PER_MONTH=1

# ── 승급 알림 & 배지 시스템 ──
# 승급 시 공개 축하 메시지를 남길 채널 이름
ANNOUNCE_CHANNEL_NAME=자유수다
# 멤버가 DM으로 "알림끄기" / "알림켜기"를 보내면 이 공개 알림 수신 여부를 스스로 끄고 켤 수 있습니다.

# ── 멘토 하이라이트 시스템 ──
# 이 이모지로 리액션을 받으면 "도움" 1회로 집계됩니다 (그로우/마스터-크루가 쓴 메시지에 한함)
HELPER_THANKS_EMOJI=🙏
# 주간 도움왕을 발표할 채널 이름
HONOR_CHANNEL_NAME=명예의-전당
# 주간 도움왕을 발표하고 집계를 리셋하는 시간 (cron, 기본 매주 일요일 오후 9시 KST)
WEEKLY_HIGHLIGHT_CRON=0 21 * * 0

# ── 버디 그룹 ──
# 첫 체크인한 멤버가 이 인원만큼 모이면 자동으로 역할+비공개 채널을 만들어 묶어줍니다.
# ⚠️ 봇에게 "채널 관리(Manage Channels)" 권한이 추가로 필요합니다 (디스코드 개발자 포털 OAuth2 URL Generator에서 다시 체크하고 재초대하거나, 서버에서 봇 역할 권한에 직접 추가해주세요).
BUDDY_GROUPS_ENABLED=true
BUDDY_GROUP_SIZE=5
BUDDY_CATEGORY_NAME=버디 그룹

# ── 주간 팁 & 회고 ──
# 매주 팁 + 회고 질문을 DM으로 보내는 시간 (cron, 기본 매주 화요일 오전 10시 KST)
WEEKLY_TIP_CRON=0 10 * * 2
# 회고 질문에 대한 답장을 인정할 시간 (시간 단위)
REFLECTION_REPLY_WINDOW_HOURS=24
